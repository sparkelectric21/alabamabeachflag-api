{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "alabamabeachflag-api-staging",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-27",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "staging.alabamabeachflag.com/admin/service/*",
			"zone_name": "alabamabeachflag.com"
		},
		{
			"pattern": "staging.alabamabeachflag.com/v1/information-reports*",
			"zone_name": "alabamabeachflag.com"
		}
	],
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"kv_namespaces": [
		{
			"binding": "BEACH_DATA",
			"id": "60f732dff736438bbb53edb2815059bb"
		}
	],
	"d1_databases": [
		{
			"binding": "HISTORICAL_DATA",
			"database_name": "alabama-beach-flag-historical-staging",
			"database_id": "701101d9-f450-4bc5-b1ac-cfbf18854fee"
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "REFRESH_COORDINATOR", "class_name": "RefreshCoordinator" },
			{ "name": "VERIFICATION_COORDINATOR", "class_name": "VerificationCoordinator" }
		]
	},
	"migrations": [
		{ "tag": "v1-refresh-coordinator", "new_sqlite_classes": ["RefreshCoordinator"] },
		{ "tag": "v2-verification-coordinator", "new_sqlite_classes": ["VerificationCoordinator"] }
	],
	"vars": {
		"APP_ENVIRONMENT": "staging",
		"STAGING_LIVE_PROVIDER_FETCH_ENABLED": "false",
		"STAGING_EXTERNAL_EMAIL_ENABLED": "false",
		"STAGING_SYNTHETIC_FIXTURES_ENABLED": "false",
		"ACCESS_ALLOWED_SERVICE_TOKENS": "1ea9ef0cf1792c8fa0cebda9f2ea39e5.access",
		"ACCESS_AUD": "8800bcaa72226e887fd0387676deae7680774fd2ad25ddb19137cee6547bd8bb,b8dda13f6db62585623946aca114a8b5e74d3a985addc21a990e8d8df7fa7ab2",
		"ACCESS_ALLOWED_IDENTITIES": "sparkelectricalservicesllc@gmail.com",
		"ACCESS_TEAM_DOMAIN": "https://green-term-7fb3.cloudflareaccess.com",
		"ALLOW_LEGACY_REFRESH_SECRET": "false",
		"VERIFICATION_API_BASE_URL": "https://alabamabeachflag-api-staging.sparkelectricalservicesllc.workers.dev",
		"VERIFICATION_ALERTS_ENABLED": "false",
		"VERIFICATION_ALERT_ENVIRONMENT": "staging",
		"HISTORICAL_DATA_ENVIRONMENT": "staging",
		"VIBRIO_CONDITIONS_ENABLED": "true"
	},
	// Staging has no schedules by default. Adding one requires separate authorization.
	"triggers": { "crons": [] }
}
